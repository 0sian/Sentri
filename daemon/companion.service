[Unit]
Description=Companion phone-as-trackpad daemon
# Started with the graphical session (uwsm for Hyprland, Plasma's systemd startup for
# KDE both activate graphical-session.target), so WAYLAND_DISPLAY and
# HYPRLAND_INSTANCE_SIGNATURE are in the environment for layout detection and wl-copy.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=%h/companion/daemon/.venv/bin/python %h/companion/daemon/companion_daemon.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
